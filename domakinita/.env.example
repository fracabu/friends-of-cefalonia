# --- Database -------------------------------------------------------------
# In locale: `docker compose up -d` alza un Postgres con queste credenziali,
# e le due variabili puntano allo stesso indirizzo.
#
# Su Neon sono due indirizzi diversi, che la console mostra affiancati:
#   DATABASE_URL  quello con "-pooler" nel nome, per l'applicazione
#   DIRECT_URL    quello senza, per le migrazioni
# Il pooler regge le tante connessioni brevi delle funzioni serverless ma non
# sa gestire le transazioni con cui Prisma applica le migrazioni.
DATABASE_URL="postgresql://immobiliare:immobiliare@localhost:5432/immobiliare?schema=public"
DIRECT_URL="postgresql://immobiliare:immobiliare@localhost:5432/immobiliare?schema=public"

# --- Sessioni -------------------------------------------------------------
# Chiave usata per firmare il cookie di sessione (JWT HS256).
# Generala con: openssl rand -base64 32
AUTH_SECRET="cambia-questa-chiave-almeno-32-caratteri-lunga"

# --- Applicazione ---------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Domakinita"

# --- Popolamento da remoto ------------------------------------------------
# Se valorizzata, abilita /api/admin/popola?chiave=... per riempire il database
# con gli annunci di esempio senza avere un computer sotto mano. Quella route
# CANCELLA e riscrive le tabelle: si imposta per il tempo della messa online e
# poi si toglie. Almeno 16 caratteri, generala con: openssl rand -hex 24
# SEED_TOKEN=""

# --- Upload immagini ------------------------------------------------------
# "local" salva in public/uploads (solo sviluppo). In produzione: s3 | uploadthing.
UPLOAD_DRIVER="local"
