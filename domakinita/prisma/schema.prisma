// Modello dati del portale annunci immobiliari.
// Convenzione: enum in inglese (stabili nel codice), etichette italiane in src/lib/labels.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // In produzione Neon dà due indirizzi: quello con il pooler, che regge le
  // tante connessioni brevi delle funzioni serverless, e quello diretto, che
  // serve alle migrazioni perché il pooler non sa gestire le transazioni DDL.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------- utenti ---

enum Role {
  USER // cerca casa: preferiti, ricerche salvate, richieste di contatto
  AGENT // pubblica annunci per conto di un'agenzia (o come privato)
  ADMIN // modera annunci e agenzie
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         Role     @default(USER)
  emailVerified DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id], onDelete: SetNull)

  listings      Listing[]
  favorites     Favorite[]
  savedSearches SavedSearch[]

  @@index([agencyId])
}

model Agency {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  logoUrl     String?
  phone       String?
  email       String?
  website     String?
  addressLine String?
  city        String?
  province    String?
  vatNumber   String?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members  User[]
  listings Listing[]
}

// -------------------------------------------------------------- annunci ---

enum ContractType {
  SALE // vendita
  RENT // affitto
}

enum PropertyType {
  APARTMENT // appartamento
  ATTIC // attico
  VILLA
  TOWNHOUSE // villetta a schiera
  LOFT
  ROOM // stanza / posto letto
  GARAGE // box e posti auto
  OFFICE // ufficio
  SHOP // negozio
  WAREHOUSE // magazzino / capannone
  LAND // terreno
  BUILDING // palazzo / stabile
}

enum ListingStatus {
  DRAFT // bozza, visibile solo in dashboard
  PUBLISHED
  RESERVED // sotto proposta
  SOLD
  RENTED
  ARCHIVED
}

enum PropertyCondition {
  NEW // nuovo / in costruzione
  RENOVATED // ristrutturato
  GOOD // buono / abitabile
  TO_RENOVATE // da ristrutturare
}

enum EnergyClass {
  A4
  A3
  A2
  A1
  A
  B
  C
  D
  E
  F
  G
  EXEMPT // esente
  PENDING // in attesa di certificazione
}

enum HeatingType {
  AUTONOMOUS // autonomo
  CENTRALIZED // centralizzato
  ABSENT // assente
}

enum Availability {
  FREE // libero
  OCCUPIED // occupato dal proprietario
  RENTED // gia affittato, a reddito
}

enum OwnershipType {
  FULL // intera proprieta
  BARE // nuda proprieta
  SHARED // multiproprieta
}

enum FurnishedState {
  FURNISHED // arredato
  PARTIALLY // parzialmente arredato
  UNFURNISHED // non arredato
}

model Listing {
  id          String        @id @default(cuid())
  slug        String        @unique
  reference   String?       @unique // codice interno dell'agenzia
  title       String
  description String        @db.Text
  contract    ContractType
  type        PropertyType
  status      ListingStatus @default(DRAFT)

  // Prezzo. `price` in euro interi: niente centesimi negli annunci.
  price          Int?
  priceOnRequest Boolean @default(false)
  condoFees      Int? // spese condominiali mensili
  deposit        Int? // cauzione, solo affitti

  // Consistenza
  surface     Int // superficie commerciale in m²
  rooms       Int // locali
  bedrooms    Int?
  bathrooms   Int?
  floor       Int? // 0 = piano terra, -1 = seminterrato
  totalFloors Int?
  yearBuilt   Int?

  // Dotazioni
  elevator   Boolean            @default(false)
  garden     Boolean            @default(false)
  terrace    Boolean            @default(false)
  balcony    Boolean            @default(false)
  parking    Boolean            @default(false)
  cellar     Boolean            @default(false)
  pool       Boolean            @default(false)
  airCon     Boolean            @default(false)
  furnished  FurnishedState?
  condition  PropertyCondition?
  heating    HeatingType?
  energy     EnergyClass?
  petsAllowed Boolean?
  features   String[] // etichette libere: "vista mare", "portineria", ...

  // Filtri che sui portali stanno in cima ai risultati.
  isAuction         Boolean        @default(false) // immobile all'asta
  isNewBuild        Boolean        @default(false) // nuova costruzione
  hasFloorPlan      Boolean        @default(false) // planimetria allegata
  virtualTourUrl    String? // tour virtuale o video
  utilitiesIncluded Boolean        @default(false) // spese incluse, negli affitti
  availability      Availability?
  ownership         OwnershipType  @default(FULL)

  // Posizione
  addressLine String?
  hideAddress Boolean @default(false) // mostra solo la zona in scheda
  city        String
  province    String // sigla: RM, MI, ...
  region      String
  postalCode  String?
  zone        String? // quartiere
  latitude    Float?
  longitude   Float?

  // Pubblicazione
  publishedAt DateTime?
  expiresAt   DateTime?
  featured    Boolean   @default(false)
  views       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  ownerId  String
  owner    User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id], onDelete: SetNull)

  images    ListingImage[]
  favorites Favorite[]
  leads     Lead[]

  // Indici pensati sui filtri della pagina di ricerca.
  @@index([status, contract, type])
  @@index([status, city, contract])
  @@index([status, price])
  @@index([status, publishedAt])
  @@index([status, contract, isAuction])
  @@index([latitude, longitude])
  @@index([ownerId])
  @@index([agencyId])
}

model ListingImage {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  thumbUrl  String?
  alt       String?
  width     Int?
  height    Int?
  position  Int     @default(0)
  isCover   Boolean @default(false)

  @@index([listingId, position])
}

// ------------------------------------------------- utente ↔ annuncio -------

model Favorite {
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@index([listingId])
}

enum AlertFrequency {
  NONE
  INSTANT
  DAILY
  WEEKLY
}

model SavedSearch {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  // I filtri salvati esattamente come stanno nell'URL di /cerca.
  query     Json
  frequency AlertFrequency @default(NONE)
  lastSentAt DateTime?
  createdAt DateTime       @default(now())

  @@index([userId])
}

enum LeadStatus {
  NEW
  CONTACTED
  SCHEDULED // visita fissata
  CLOSED
  SPAM
}

model Lead {
  id        String     @id @default(cuid())
  listingId String
  listing   Listing    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  name      String
  email     String
  phone     String?
  message   String     @db.Text
  status    LeadStatus @default(NEW)
  createdAt DateTime   @default(now())

  @@index([listingId, createdAt])
  @@index([status])
}

// ------------------------------------------------------------- geografia ---

enum LocationType {
  REGION
  PROVINCE
  CITY
  ZONE
}

/// Alimenta l'autocomplete della barra di ricerca e le pagine per città.
model Location {
  id       String       @id @default(cuid())
  slug     String       @unique
  name     String
  type     LocationType
  province String?
  region   String?
  latitude Float?
  longitude Float?
  parentId String?
  parent   Location?    @relation("LocationChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children Location[]   @relation("LocationChildren")

  @@index([type, name])
  @@index([parentId])
}
